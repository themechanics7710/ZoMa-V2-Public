# ZoMa — repository-wide ignore rules.
# Property of TheMechanics. Contact: mamau.mechanics@gmail.com

# Secrets & Configs
*.env
*.local.yaml
*.local.json
secrets/
credentials/

# Python / ROS / Micro-ROS build artifacts
__pycache__/
*.py[cod]
*$py.class
*.log
install/
build/
log/

# C++ / Arduino / PlatformIO
.pio/
.vscode/
*.o
*.a
*.so

# OS / Editor artifacts
.DS_Store
Thumbs.db

# Runtime data that must never be committed to this public repo:
# recorded audio, conversation memory, and captured photos.
*.wav
*.mp3
*.faiss
monster/zoma-brain/data/**
!monster/zoma-brain/data/.gitkeep
!monster/zoma-brain/data/**/.gitkeep
monster/zoma-brain/pictures/*
!monster/zoma-brain/pictures/.gitkeep
pi/scripts/zoma-audio-led/sounds/*
!pi/scripts/zoma-audio-led/sounds/.gitkeep

# A builder's own progress notes (see MY_PROGRESS.template.md) -- personal,
# never committed.
MY_PROGRESS.md
